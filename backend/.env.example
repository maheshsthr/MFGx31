# Copy this file to backend/.env and fill in real values.
# Set the same variables as Environment Variables in Vercel for production/preview.
# NEVER commit backend/.env — it is gitignored.

# Supabase project URL
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable key (new-style anon key). Used client-side auth calls (signInWithPassword).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# Secret key (new-style service-role key). NEVER expose to the browser.
# Used for admin provisioning, CRUD and JWT verification.
SUPABASE_SECRET_KEY=sb_secret_xxxx

# Comma-separated list of allowed CORS origins (frontend Vercel domains + previews).
# *.vercel.app is always allowed automatically.
CLIENT_ORIGIN=https://your-client.vercel.app,http://localhost:5173